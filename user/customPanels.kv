## =============================================================================
## WEATHER RADAR PANEL AND BUTTON
## =============================================================================
<WeatherRadarPanel>:
    ## Dark panel background with "Weather Radar" title bar
    PanelBackground:
        _panelTitle: 'Weather Radar'

    ## Radar animation image — fills the content area between title and edge
    Image:
        id: radar_image
        source: ''
        pos_hint: {'x': 5/262, 'y': 18/202}
        size_hint: (252/262, 163/202)
        allow_stretch: True
        keep_ratio: True

    ## Status / loading label, hidden once frames are available
    Label:
        id: status_label
        text: 'Loading radar…'
        opacity: 1
        pos_hint: {'x': 5/262, 'y': 18/202}
        size_hint: (252/262, 163/202)
        font_name: 'fonts/Inter-Medium.ttf'
        font_size: dp(14*app.scaleFactor)
        color: utils.rgba('#c8c8c8ff')
        halign: 'center'
        valign: 'center'
        markup: 1

<WeatherRadarButton>:
    PanelButton:
        text: 'Weather Radar'
        on_release: app.CurrentConditions.switchPanel(self)
